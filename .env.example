# ── PostHog analytics ────────────────────────────────────────────────
# Set both in Vercel → Project (aura-life) → Settings → Environment
# Variables (Production + Preview). For local dev, copy to .env.local.
# Leaving NEXT_PUBLIC_POSTHOG_KEY empty disables analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Ask Aura ─────────────────────────────────────────────────────────
# Server-side only. Never prefixed NEXT_PUBLIC_ — this key must not
# reach the browser. Set in Vercel → Settings → Environment Variables.
OPENAI_API_KEY=sk-proj-...

# Extra origins the answer endpoint will accept, comma separated.
# Production and www are built in; Vercel preview URLs are admitted
# automatically via VERCEL_URL. Add a custom staging domain here.
# ASK_AURA_ALLOWED_ORIGINS=https://staging.theaura.life


# ── Aura Live ────────────────────────────────────────────────────────
# The public feed at /live. Everything here is server-side; none of it
# is prefixed NEXT_PUBLIC_ and none of it reaches the browser.
#
# The gateway is read-only. Nothing this app does writes to it, to the
# estate's Google Drive, or to any upstream source.
AURA_GATEWAY_BASE_URL=https://aura-mcp-seven.vercel.app/api/v1/gateway
AURA_GATEWAY_TIMEOUT_MS=12000
AURA_GATEWAY_RETRIES=2

# Publishing windows, in the estate's own time (Asia/Kolkata). A
# scheduled run outside every window exits without touching anything.
AURA_LIVE_WINDOWS=06:00-10:00,15:00-19:30
# Set to 1 to publish at any hour. For backfills, not for production.
# AURA_LIVE_IGNORE_WINDOWS=0

# Eligibility. The gateway emits 0.94–0.98 on reviewed operational
# records and 0.72 on recommendations, so 0.90 sits in the gap between
# "confirmed" and "suggested".
AURA_LIVE_MIN_CONFIDENCE=0.9
AURA_LIVE_REVIEW_STATUSES=reviewed,approved

# An entry carries a photograph when the estate took one of the event,
# and otherwise carries none. Set to 1 to bring back the archive-image
# fallback, which is always labelled as archive imagery on the entry.
# AURA_LIVE_ARCHIVE_IMAGES=0

# Editorial. Raise the score to publish less; it is not a quality
# ceiling, only a bar.
AURA_LIVE_MIN_SCORE=8
AURA_LIVE_MAX_PUBLISH_PER_RUN=6
AURA_LIVE_MAX_FEED_ENTRIES=60
AURA_LIVE_LOOKBACK_DAYS=120

# Above this many minutes since the gateway's last successful sync, the
# page stops calling itself live and the job stops publishing. It keeps
# everything already published.
AURA_LIVE_STALE_AFTER_MINUTES=180

# Individuals cleared to be named on the public site. Anyone else who
# appears in a "Done By" column becomes "Aura's estate team"; team
# credits such as "Sadananda's Team" are used as the source wrote them.
# AURA_LIVE_CLEARED_NAMES=Pulkit,Rao,Chander

# Species whose exact block is withheld. The sighting is still published.
# AURA_LIVE_SENSITIVE_TAXA=gaur,bison,elephant,tiger,leopard,pangolin,hornbill,orchid

# The rainfall sheet records one number a day and never says what it
# measures. Rainfall stays out of the feed until somebody confirms the
# unit; set it here (mm or in) to turn those entries on.
# AURA_LIVE_RAINFALL_UNIT=

# Optional model stage for copy. Off by default: deterministic templates
# write every card, and anything the model returns is checked against the
# same evidence and discarded if it does not trace.
# AURA_LIVE_LLM=false
# AURA_LIVE_LLM_MODEL=gpt-4.1-mini

# Durable store for the publication ledger. "blob" on Vercel (needs
# BLOB_READ_WRITE_TOKEN, which the Blob integration sets for you);
# "file" locally and in tests.
# AURA_LIVE_STORE=file
# AURA_LIVE_STORE_FILE=.aura-live/feed.json
# AURA_LIVE_STORE_KEY=aura-live/feed.json

# Vercel Cron sends this as a bearer token. Without it, the job endpoint
# refuses every request in production.
# CRON_SECRET=

# Conditions at Mudigere — weather and ground, from Open-Meteo's free
# key-free API, shown in the Today card and never in the feed. It is
# modelled at a grid point about 4 km from the estate, and the card says
# so. Set to 0 to remove the band entirely.
# AURA_LIVE_CONDITIONS=1
