# ── PostHog analytics ────────────────────────────────────────────────
# Set both in Vercel → Project (aura-life) → Settings → Environment
# Variables (Production + Preview). For local dev, copy to .env.local.
# Leaving NEXT_PUBLIC_POSTHOG_KEY empty disables analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
