# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large source videos — exceed GitHub/Vercel 100 MB per-file caps.
# The "Enter the ecosystem" film modal references these; ship a smaller
# encode or host them externally before re-enabling.
/public/aura-25.mp4
/public/aura-25.webm
.gstack/

# Ask Aura — crawled page bodies. Regenerated by
# `node scripts/ask-aura/crawl.mjs`; the inventory beside them keeps the
# content hashes that incremental refresh compares against.
data/ask-aura/pages/

# Ask Aura — Codex review transcripts. The findings are acted on in the
# code and summarised in docs/ask-aura/threat-model.md; the raw tool-call
# logs are large and of no use once read.
artifacts/
