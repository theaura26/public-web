{
  "$schema": "https://design-tokens.org/draft",
  "$description": "AURA design tokens — the single source of truth for the design system. Mirrors app/globals.css and the Figma variable collections in 'AURA / Brand' (AURA / Colour · Space & Layout · Type · Motion). Colour carries two modes: night (the CSS :root default) and day ([data-theme=\"day\"]).",
  "$repo": "github.com/theaura26/public-web",
  "$figmaFile": "z7leADFNDcX6ey0CzUsCFb",
  "colour": {
    "$collection": "AURA / Colour",
    "$modes": [
      "night",
      "day"
    ],
    "brand/green": {
      "css": "--brand-green",
      "night": "#36483A",
      "day": "#36483A",
      "desc": "Brand green. The dark ground under the Regenerative Coffee chapters, the closing statements and the banners — immutable across themes, like the accent."
    },
    "brand/accent-lift": {
      "css": "--brand-accent-lift",
      "night": "#F5A56B",
      "day": "#F5A56B",
      "desc": "The accent, lifted for accent-coloured text on --brand-green. The base accent reads 6.66:1 on black but only 3.10:1 on the green, which is under AA; this is 4.88:1. Accent as a fill is unaffected."
    },
    "surface/bg": {
      "css": "--bg",
      "night": "#131719",
      "day": "#ffffff",
      "desc": "Page background"
    },
    "surface/bg-card": {
      "css": "--bg-card",
      "night": "#1a1d20",
      "day": "#ffffff",
      "desc": "Card / raised surface"
    },
    "text/primary": {
      "css": "--text",
      "night": "#ffffff",
      "day": "#131719",
      "desc": "Primary text"
    },
    "text/body": {
      "css": "--text-body",
      "night": "rgba(255, 255, 255,0.65)",
      "day": "rgba(19, 23, 25,0.65)",
      "desc": "Secondary body text"
    },
    "text/muted": {
      "css": "--text-muted",
      "night": "rgba(255, 255, 255,0.4)",
      "day": "rgba(19, 23, 25,0.4)",
      "desc": "Meta / labels"
    },
    "text/dim": {
      "css": "--text-dim",
      "night": "rgba(255, 255, 255,0.25)",
      "day": "rgba(19, 23, 25,0.25)",
      "desc": "Captions / fine print"
    },
    "border/default": {
      "css": "--border",
      "night": "rgba(255,255,255,0.08)",
      "day": "rgba(0,0,0,0.08)",
      "desc": "Hairline rules"
    },
    "border/strong": {
      "css": "--border-strong",
      "night": "rgba(255,255,255,0.14)",
      "day": "rgba(0,0,0,0.14)",
      "desc": "Framed records, SpecTable"
    },
    "state/selection": {
      "css": "--selection",
      "night": "rgba(227,113,40,0.32)",
      "day": "rgba(227,113,40,0.24)",
      "desc": "Text selection — brand accent at low alpha"
    },
    "contrast/bg": {
      "css": "--contrast-bg",
      "night": "#ffffff",
      "day": "#131719",
      "desc": "Inverted surface — always the opposite of the page theme"
    },
    "contrast/bg-card": {
      "css": "--contrast-bg-card",
      "night": "#ffffff",
      "day": "#1a1d20",
      "desc": "Inverted card surface"
    },
    "contrast/text": {
      "css": "--contrast-text",
      "night": "#131719",
      "day": "#ffffff",
      "desc": "Text on inverted surface"
    },
    "contrast/text-body": {
      "css": "--contrast-text-body",
      "night": "rgba(19, 23, 25,0.65)",
      "day": "rgba(255, 255, 255,0.65)",
      "desc": "Body on inverted surface"
    },
    "contrast/text-muted": {
      "css": "--contrast-text-muted",
      "night": "rgba(19, 23, 25,0.4)",
      "day": "rgba(255, 255, 255,0.4)",
      "desc": "Muted on inverted surface"
    },
    "contrast/border": {
      "css": "--contrast-border",
      "night": "rgba(0,0,0,0.08)",
      "day": "rgba(255,255,255,0.08)",
      "desc": "Border on inverted surface"
    },
    "brand/accent": {
      "css": "--brand-accent",
      "night": "#E37128",
      "day": "#E37128",
      "desc": "Primary action / hover / record headers"
    },
    "brand/error": {
      "css": "--error",
      "night": "#E8421A",
      "day": "#E8421A",
      "desc": "Form validation, destructive UI"
    },
    "success": {
      "css": "--success",
      "night": "#1F6B4B",
      "day": "#1F6B4B",
      "desc": "Confirmed state — form sent, validation passed."
    }
  },
  "space": {
    "$collection": "AURA / Space & Layout",
    "$note": "Tokens declared with clamp() are responsive; the value here is the desktop maximum, and `clamp` records the full CSS expression.",
    "space/2": {
      "css": "--space-2",
      "value": 8,
      "desc": "Base step"
    },
    "space/3": {
      "css": "--space-3",
      "value": 12
    },
    "space/4": {
      "css": "--space-4",
      "value": 16
    },
    "space/5": {
      "css": "--space-5",
      "value": 24
    },
    "space/6": {
      "css": "--space-6",
      "value": 32
    },
    "space/7": {
      "css": "--space-7",
      "value": 48
    },
    "space/8": {
      "css": "--space-8",
      "value": 64
    },
    "space/9": {
      "css": "--space-9",
      "value": 80,
      "desc": "Largest step"
    },
    "radius/1": {
      "css": "--radius-1",
      "value": 2,
      "desc": "Tiles, video frames, cards"
    },
    "radius/2": {
      "css": "--radius-2",
      "value": 4,
      "desc": "Buttons, inputs"
    },
    "layout/nav-height": {
      "css": "--nav-h",
      "value": 56,
      "desc": "Fixed navbar height"
    },
    "layout/max-width": {
      "css": "--max-w",
      "value": 1200,
      "desc": "Primary content width"
    },
    "layout/gutter": {
      "css": "--gutter",
      "value": 48,
      "clamp": "clamp(20px, 4vw, 48px)",
      "desc": "Horizontal page padding"
    },
    "layout/section-gap": {
      "css": "--section-gap",
      "value": 140,
      "clamp": "clamp(80px, 12vh, 140px)",
      "desc": "Between major sections"
    },
    "layout/grid-gap": {
      "css": "--grid-gap",
      "value": 80,
      "clamp": "clamp(32px, 5vw, 80px)",
      "desc": "Between grid items"
    },
    "layout/z-modal": {
      "css": "--z-modal",
      "value": 9990,
      "desc": "Full-screen modal layer (LocationModal / ContactModal)"
    }
  },
  "type": {
    "$collection": "AURA / Type",
    "$roles": "DM Mono = labels/eyebrows/data keys (uppercase). Bricolage Grotesque = body and values. Small muted Bricolage = captions. Mynerve/Belmonte = decorative only.",
    "family/body": {
      "css": "--font-sans",
      "value": "Bricolage Grotesque",
      "desc": "Body + values. --font-sans aliases --font-grotesque"
    },
    "family/mono": {
      "css": "--font-mono",
      "value": "DM Mono",
      "desc": "Labels, eyebrows, data keys — always uppercase"
    },
    "family/pullquote": {
      "css": "--font-hand",
      "value": "Mynerve",
      "desc": "PullQuote only"
    },
    "size/p1": {
      "value": 16,
      "lineHeight": 1.55,
      "desc": "Primary body (.p1)"
    },
    "size/p2": {
      "value": 14,
      "lineHeight": 1.6,
      "desc": "Secondary body (.p2)"
    },
    "size/label": {
      "value": 11,
      "desc": "Label / eyebrow (.label) — uppercase, 1px tracking"
    },
    "size/caption": {
      "value": 12.5,
      "desc": "Caption / fine print — small muted Bricolage"
    },
    "tracking/label": {
      "value": 1,
      "desc": "Letter-spacing on .label"
    }
  },
  "motion": {
    "$collection": "AURA / Motion",
    "duration/fast": {
      "css": "--dur-fast",
      "value": 150,
      "unit": "ms",
      "desc": "Micro transitions"
    },
    "duration/base": {
      "css": "--dur-base",
      "value": 250,
      "unit": "ms",
      "desc": "Standard"
    },
    "duration/slow": {
      "css": "--dur-slow",
      "value": 450,
      "unit": "ms",
      "desc": "Deliberate reveals"
    },
    "duration/theme": {
      "css": "--dur-theme",
      "value": 400,
      "unit": "ms",
      "desc": "Day/night cross-fade"
    },
    "easing/standard": {
      "css": "--ease",
      "value": "cubic-bezier(0.4, 0, 0.2, 1)",
      "desc": "Material standard — colour, opacity, border"
    },
    "easing/out": {
      "css": "--ease-out",
      "value": "cubic-bezier(0.19, 1, 0.22, 1)",
      "desc": "easeOutExpo — hero reveals, panel slides"
    },
    "easing/spring": {
      "css": "--ease-spring",
      "value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "desc": "Spring micro-snap — navbar tile, Continue card"
    }
  }
}
